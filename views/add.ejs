<!DOCTYPE html>
<html lang="en">
<head>
  <% var title = 'Add Title' %>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <div class="wrap-narrow">
    <h1 class="section-title fade-in" style="font-size:1.9rem;">Add a Title</h1>
    <p class="fade-in" style="color:var(--text-dim); margin-top:0; margin-bottom:24px;">
      Just watched something worth keeping? Or want to queue it up for later? Fill this in.
    </p>

    <div class="form-card fade-in">
      <form method="POST" action="/add">

        <div class="field">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" placeholder="e.g. Oppenheimer('23)" required autofocus>
          <div class="hint">Add the year in parentheses if the name is common, e.g. <em>It (2017)</em>.</div>
        </div>

        <div class="field">
          <label>Type</label>
          <div class="radio-row">
            <label class="radio-opt"><input type="radio" name="type" value="movie" checked> Movie</label>
            <label class="radio-opt"><input type="radio" name="type" value="series"> Series</label>
          </div>
        </div>

        <div class="field">
          <label for="category">Category</label>
          <input type="text" id="category" name="category" list="categoryList" placeholder="e.g. SuperHero, Horror, Comedy..." required>
          <datalist id="categoryList">
            <% categories.forEach(function(c) { %><option value="<%= c %>"><% }) %>
          </datalist>
          <div class="hint">Pick an existing one from the list, or just type a new category to start one.</div>
        </div>

        <div class="field">
          <label for="subcategory">Subcategory <span style="text-transform:none; font-weight:400;">(optional)</span></label>
          <input type="text" id="subcategory" name="subcategory" placeholder="e.g. Marvel, DC, Korean...">
        </div>

        <div class="field">
          <label>Origin</label>
          <div class="radio-row">
            <label class="radio-opt"><input type="radio" name="origin" value="International" checked> International</label>
            <label class="radio-opt"><input type="radio" name="origin" value="Indian"> Indian</label>
            <label class="radio-opt"><input type="radio" name="origin" value="Mixed"> Mixed</label>
          </div>
        </div>

        <div class="field">
          <label>Where should this go?</label>
          <div class="radio-row">
            <label class="radio-opt">
              <input type="radio" name="status" value="collection" <%= defaultStatus === 'collection' ? 'checked' : '' %>>
              Collection (already watched)
            </label>
            <label class="radio-opt">
              <input type="radio" name="status" value="watchlist" <%= defaultStatus === 'watchlist' ? 'checked' : '' %>>
              Watchlist (want to watch)
            </label>
          </div>
        </div>

        <div class="field">
          <label for="notes">Notes <span style="text-transform:none; font-weight:400;">(optional)</span></label>
          <textarea id="notes" name="notes" placeholder="Anything you want to remember about it"></textarea>
        </div>

        <div class="form-actions">
          <a href="/browse" class="hint">Cancel</a>
          <button type="submit" class="btn btn-gold">Save Title</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
