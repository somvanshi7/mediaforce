<!DOCTYPE html>
<html lang="en">
<head>
  <% var title = 'Edit Title' %>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <div class="wrap-narrow">
    <h1 class="section-title fade-in" style="font-size:1.9rem;">Edit Title</h1>

    <div class="form-card fade-in">
      <form method="POST" action="/edit/<%= item.id %>">

        <div class="field">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" value="<%= item.title %>" required autofocus>
        </div>

        <div class="field">
          <label>Type</label>
          <div class="radio-row">
            <label class="radio-opt"><input type="radio" name="type" value="movie" <%= item.type === 'movie' ? 'checked' : '' %>> Movie</label>
            <label class="radio-opt"><input type="radio" name="type" value="series" <%= item.type === 'series' ? 'checked' : '' %>> Series</label>
          </div>
        </div>

        <div class="field">
          <label for="category">Category</label>
          <input type="text" id="category" name="category" list="categoryList" value="<%= item.category %>" required>
          <datalist id="categoryList">
            <% categories.forEach(function(c) { %><option value="<%= c %>"><% }) %>
          </datalist>
        </div>

        <div class="field">
          <label for="subcategory">Subcategory <span style="text-transform:none; font-weight:400;">(optional)</span></label>
          <input type="text" id="subcategory" name="subcategory" value="<%= item.subcategory %>">
        </div>

        <div class="field">
          <label>Origin</label>
          <div class="radio-row">
            <label class="radio-opt"><input type="radio" name="origin" value="International" <%= item.origin === 'International' ? 'checked' : '' %>> International</label>
            <label class="radio-opt"><input type="radio" name="origin" value="Indian" <%= item.origin === 'Indian' ? 'checked' : '' %>> Indian</label>
            <label class="radio-opt"><input type="radio" name="origin" value="Mixed" <%= item.origin === 'Mixed' ? 'checked' : '' %>> Mixed</label>
          </div>
        </div>

        <div class="field">
          <label>Where should this go?</label>
          <div class="radio-row">
            <label class="radio-opt">
              <input type="radio" name="status" value="collection" <%= item.status === 'collection' ? 'checked' : '' %>>
              Collection (already watched)
            </label>
            <label class="radio-opt">
              <input type="radio" name="status" value="watchlist" <%= item.status === 'watchlist' ? 'checked' : '' %>>
              Watchlist (want to watch)
            </label>
          </div>
        </div>

        <div class="field">
          <label for="notes">Notes <span style="text-transform:none; font-weight:400;">(optional)</span></label>
          <textarea id="notes" name="notes"><%= item.notes %></textarea>
        </div>

        <div class="form-actions">
          <a href="/browse" class="hint">Cancel</a>
          <button type="submit" class="btn btn-gold">Save Changes</button>
        </div>
      </form>

      <form method="POST" action="/delete/<%= item.id %>" onsubmit="return confirm('Permanently remove &quot;<%= item.title.replace(/'/g, '') %>&quot;?');" style="margin-top:14px; text-align:right;">
        <input type="hidden" name="from" value="<%= item.status === 'watchlist' ? 'watchlist' : 'browse' %>">
        <button type="submit" style="background:none; border:none; color:var(--danger); font-size:0.85rem; cursor:pointer;">Delete this title</button>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
