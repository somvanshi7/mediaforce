# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.uumuda7.mongodb.net/mediaforce?retryWrites=true&w=majority

# Optional: PIN for securing the app (leave empty for open access in dev)
APP_PIN=

# Optional: Port number (defaults to 3000)
PORT=3000

# Optional: Session Secret
SESSION_SECRET=mediaforce-secret-key-change-me
